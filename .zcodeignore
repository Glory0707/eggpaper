*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Node / frontend
node_modules/
dist-ssr/

# Local config & secrets — never commit
config*.yaml
config*.toml
.env
*.key

# User data — never commit
data/
logs/
library/
*.pdf

_qa/
_*.log
_pid.txt

# 作者私人笔记（作者要求不上传）
docs/作者手记.md
_cmsg.txt

# 打包产物（安装包与冻结目录不入库；release/ 里的 latest.json 是发布产物）
build/
release/
.build-venv/
installer/eggpaper.ico
installer/eggpaper-256.png


# 走查/审计的临时截图与 playwright 快照
/audit-*.png
.playwright-mcp/

# 全文翻译引擎（源码运行时装在 backend/engines/，~1.3GB，永不入库）
backend/engines/

